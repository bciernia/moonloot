  translationSets:
  - counter: 28
    languageCode: en
    translations:
    - id: 0
      language: en
      text: Quest Giver
    - id: 1
      language: en
      text: 'Hello

'
    - id: 2
      language: en
      text: Give me quest
    - id: 3
      language: en
      text: Exit
    - id: 4
      language: en
      text: (@questStory)
    - id: 5
      language: en
      text: "Yes\t"
    - id: 6
      language: en
      text: What do you want?
    - id: 7
      language: en
      text: Thank you!
    - id: 8
      language: en
      text: Talk about the quest
    - id: 9
      language: en
      text: You haven't completed the task yet. Keep at it, and come back when it's
        done.
    - id: 10
      language: en
      text: Qeust Giver
    - id: 11
      language: en
      text: Thank you for completing the task. Here's your reward.
    - id: 12
      language: en
      text: (@giverName)
    - id: 13
      language: en
      text: (@questTurnInDialogue)
    - id: 14
      language: en
      text: (@turninDialogue)
    - id: 15
      language: en
      text: Hello hero!
    - id: 16
      language: en
      text: Do you need something?
    - id: 17
      language: en
      text: Tell me about your task.
    - id: 18
      language: en
      text: Yes
    - id: 19
      language: en
      text: (@turnInDialogue)
    - id: 20
      language: en
      text: Good morning my friend!
    - id: 21
      language: en
      text: Oh, it's you again! What can I do for you?
    - id: 22
      language: en
      text: Good to see you! How can I help?
    - id: 23
      language: en
      text: Welcome! What brings you here?
    - id: 24
      language: en
      text: I hope last night wasn't too rough on you.
    - id: 25
      language: en
      text: Something else on your mind?
    - id: 26
      language: en
      text: What else would you like to know?
    - id: 27
      language: en
      text: Anything more you'd like to discuss?
