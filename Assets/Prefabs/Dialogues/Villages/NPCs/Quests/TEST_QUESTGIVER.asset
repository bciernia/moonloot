  translationSets:
  - counter: 28
    languageCode: en
    translations:
    - id: 0
      language: en
      text: Quest Giver
    - id: 1
      language: en
      text: 'Hello

'
    - id: 2
      language: en
      text: Give me quest
    - id: 3
      language: en
      text: Exit
    - id: 4
      language: en
      text: (@questStory)
    - id: 5
      language: en
      text: "Yes\t"
    - id: 6
      language: en
      text: What do you want?
    - id: 7
      language: en
      text: Thank you!
    - id: 8
      language: en
      text: Talk about the quest
    - id: 9
      language: en
      text: You haven't completed the task yet. Keep at it, and come back when it's
        done.
    - id: 10
      language: en
      text: Qeust Giver
    - id: 11
      language: en
      text: Thank you for completing the task. Here's your reward.
    - id: 12
      language: en
      text: (@giverName)
    - id: 13
      language: en
      text: (@questTurnInDialogue)
    - id: 14
      language: en
      text: (@turninDialogue)
    - id: 15
      language: en
      text: Hello hero!
    - id: 16
      language: en
      text: Do you need something?
    - id: 17
      language: en
      text: Tell me about your task.
    - id: 18
      language: en
      text: Yes
    - id: 19
      language: en
      text: (@turnInDialogue)
    - id: 20
      language: en
      text: Good morning my friend!
    - id: 21
      language: en
      text: Oh, it's you again! What can I do for you?
    - id: 22
      language: en
      text: Good to see you! How can I help?
    - id: 23
      language: en
      text: Welcome! What brings you here?
    - id: 24
      language: en
      text: I hope last night wasn't too rough on you.
    - id: 25
      language: en
      text: Something else on your mind?
    - id: 26
      language: en
      text: What else would you like to know?
    - id: 27
      language: en
      text: Anything more you'd like to discuss?
  - counter: 28
    languageCode: pl
    translations:
    - id: 0
      language: pl
      text: Zleceniodawca
    - id: 1
      language: pl
      text: "Cze\u015B\u0107\n\n"
    - id: 2
      language: pl
      text: "Poprosz\u0119 o zadanie"
    - id: 3
      language: pl
      text: "Wyjd\u017A"
    - id: 4
      language: pl
      text: (@questStory)
    - id: 5
      language: pl
      text: "Tak\t"
    - id: 6
      language: pl
      text: Czego potrzebujesz?
    - id: 7
      language: pl
      text: "Dzi\u0119kuj\u0119!"
    - id: 8
      language: pl
      text: Porozmawiajmy o zadaniu
    - id: 9
      language: pl
      text: "Nie uda\u0142o Ci si\u0119 jeszcze uko\u0144czy\u0107 zadania. Nie poddawaj
        si\u0119 i wr\xF3\u0107, gdy b\u0119dzie gotowe."
    - id: 10
      language: pl
      text: Zleceniodawca
    - id: 11
      language: pl
      text: "Dzi\u0119kuj\u0119 za wykonanie zadania. Oto Twoja nagroda."
    - id: 12
      language: pl
      text: (@giverName)
    - id: 13
      language: pl
      text: (@questTurnInDialogue)
    - id: 14
      language: pl
      text: (@turninDialogue)
    - id: 15
      language: pl
      text: Witaj, bohaterze!
    - id: 16
      language: pl
      text: "Czy czego\u015B potrzebujesz?"
    - id: 17
      language: pl
      text: Opowiedz mi o swoim zadaniu.
    - id: 18
      language: pl
      text: Tak
    - id: 19
      language: pl
      text: (@turnInDialogue)
    - id: 20
      language: pl
      text: "Dzie\u0144 dobry, przyjacielu!"
    - id: 21
      language: pl
      text: "Och, znowu Ty! W czym mog\u0119 pom\xF3c?"
    - id: 22
      language: pl
      text: "Dobrze Ci\u0119 widzie\u0107! Jak mog\u0119 pom\xF3c?"
    - id: 23
      language: pl
      text: "Witaj! Co Ci\u0119 sprowadza?"
    - id: 24
      language: pl
      text: "Mam nadziej\u0119, \u017Ce ostatnia noc nie da\u0142a Ci si\u0119 za
        bardzo we znaki."
    - id: 25
      language: pl
      text: "Masz jeszcze co\u015B na my\u015Bli?"
    - id: 26
      language: pl
      text: "Czego jeszcze chcesz si\u0119 dowiedzie\u0107?"
    - id: 27
      language: pl
      text: "Chcesz porozmawia\u0107 jeszcze o czym\u015B?"
  - counter: 28
    languageCode: fr
    translations:
    - id: 0
      language: fr
      text: "Donneur de qu\xEAte"
    - id: 1
      language: fr
      text: 'Bonjour


'
    - id: 2
      language: fr
      text: "Propose-moi une qu\xEAte"
    - id: 3
      language: fr
      text: Partir
    - id: 4
      language: fr
      text: (@questStory)
    - id: 5
      language: fr
      text: "Oui\t"
    - id: 6
      language: fr
      text: Que veux-tu ?
    - id: 7
      language: fr
      text: Merci !
    - id: 8
      language: fr
      text: "Parler de la qu\xEAte"
    - id: 9
      language: fr
      text: "Tu n'as pas encore termin\xE9 la t\xE2che. Continue et reviens quand
        ce sera fait."
    - id: 10
      language: fr
      text: "Donneur de qu\xEAte"
    - id: 11
      language: fr
      text: "Merci d'avoir accompli la t\xE2che. Voici ta r\xE9compense."
    - id: 12
      language: fr
      text: (@giverName)
    - id: 13
      language: fr
      text: (@questTurnInDialogue)
    - id: 14
      language: fr
      text: (@turninDialogue)
    - id: 15
      language: fr
      text: "Salut, h\xE9ros !"
    - id: 16
      language: fr
      text: As-tu besoin de quelque chose ?
    - id: 17
      language: fr
      text: "Parle-moi de ta t\xE2che."
    - id: 18
      language: fr
      text: Oui
    - id: 19
      language: fr
      text: (@turnInDialogue)
    - id: 20
      language: fr
      text: Bonjour, mon ami !
    - id: 21
      language: fr
      text: "Oh, te revoil\xE0 ! Que puis-je faire pour toi ?"
    - id: 22
      language: fr
      text: Ravi de te voir ! Comment puis-je t'aider ?
    - id: 23
      language: fr
      text: "Bienvenue ! Qu'est-ce qui t'am\xE8ne ?"
    - id: 24
      language: fr
      text: "J'esp\xE8re que la nuit derni\xE8re n'a pas \xE9t\xE9 trop dure."
    - id: 25
      language: fr
      text: "Autre chose te pr\xE9occupe ?"
    - id: 26
      language: fr
      text: Que souhaites-tu savoir d'autre ?
    - id: 27
      language: fr
      text: Souhaites-tu parler d'autre chose ?
  - counter: 28
    languageCode: es
    translations:
    - id: 0
      language: es
      text: Dador de misiones
    - id: 1
      language: es
      text: "\xA1Hola!\n\n"
    - id: 2
      language: es
      text: "Quiero una misi\xF3n"
    - id: 3
      language: es
      text: Salir
    - id: 4
      language: es
      text: (@questStory)
    - id: 5
      language: es
      text: "S\xED\t"
    - id: 6
      language: es
      text: "\xBFQu\xE9 necesitas?"
    - id: 7
      language: es
      text: "\xA1Gracias!"
    - id: 8
      language: es
      text: "Hablar de la misi\xF3n"
    - id: 9
      language: es
      text: "A\xFAn no has completado la tarea. Sigue intent\xE1ndolo y vuelve cuando
        est\xE9 hecha."
    - id: 10
      language: es
      text: Dador de misiones
    - id: 11
      language: es
      text: "Gracias por completar la tarea. Aqu\xED tienes tu recompensa."
    - id: 12
      language: es
      text: (@giverName)
    - id: 13
      language: es
      text: (@questTurnInDialogue)
    - id: 14
      language: es
      text: (@turninDialogue)
    - id: 15
      language: es
      text: "\xA1Hola, h\xE9roe!"
    - id: 16
      language: es
      text: "\xBFNecesitas algo?"
    - id: 17
      language: es
      text: "Cu\xE9ntame sobre tu tarea."
    - id: 18
      language: es
      text: "S\xED"
    - id: 19
      language: es
      text: (@turnInDialogue)
    - id: 20
      language: es
      text: "\xA1Buenos d\xEDas, amigo!"
    - id: 21
      language: es
      text: "\xA1Vaya, otra vez t\xFA! \xBFEn qu\xE9 puedo ayudarte?"
    - id: 22
      language: es
      text: "\xA1Me alegro de verte! \xBFC\xF3mo puedo ayudarte?"
    - id: 23
      language: es
      text: "\xA1Bienvenido! \xBFQu\xE9 te trae por aqu\xED?"
    - id: 24
      language: es
      text: Espero que la noche pasada no haya sido demasiado dura.
    - id: 25
      language: es
      text: "\xBFTienes algo m\xE1s en mente?"
    - id: 26
      language: es
      text: "\xBFQu\xE9 m\xE1s te gustar\xEDa saber?"
    - id: 27
      language: es
      text: "\xBFQuieres hablar de algo m\xE1s?"
  - counter: 28
    languageCode: it
    translations:
    - id: 0
      language: it
      text: Incaricato delle missioni
    - id: 1
      language: it
      text: 'Ciao


'
    - id: 2
      language: it
      text: Vorrei una missione
    - id: 3
      language: it
      text: Esci
    - id: 4
      language: it
      text: (@questStory)
    - id: 5
      language: it
      text: "S\xEC\t"
    - id: 6
      language: it
      text: Di cosa hai bisogno?
    - id: 7
      language: it
      text: Grazie!
    - id: 8
      language: it
      text: Parliamo della missione
    - id: 9
      language: it
      text: Non hai ancora completato l'incarico. Continua e torna quando l'avrai
        finito.
    - id: 10
      language: it
      text: Incaricato delle missioni
    - id: 11
      language: it
      text: Grazie per aver completato l'incarico. Ecco la tua ricompensa.
    - id: 12
      language: it
      text: (@giverName)
    - id: 13
      language: it
      text: (@questTurnInDialogue)
    - id: 14
      language: it
      text: (@turninDialogue)
    - id: 15
      language: it
      text: Ciao, eroe!
    - id: 16
      language: it
      text: Ti serve qualcosa?
    - id: 17
      language: it
      text: Parlami del tuo incarico.
    - id: 18
      language: it
      text: "S\xEC"
    - id: 19
      language: it
      text: (@turnInDialogue)
    - id: 20
      language: it
      text: Buongiorno, amico mio!
    - id: 21
      language: it
      text: Oh, sei di nuovo tu! Come posso aiutarti?
    - id: 22
      language: it
      text: Che bello vederti! Come posso aiutarti?
    - id: 23
      language: it
      text: Benvenuto! Cosa ti porta qui?
    - id: 24
      language: it
      text: Spero che la scorsa notte non sia stata troppo dura.
    - id: 25
      language: it
      text: Hai altro in mente?
    - id: 26
      language: it
      text: Cos'altro vorresti sapere?
    - id: 27
      language: it
      text: Vuoi parlare di qualcos'altro?
  - counter: 28
    languageCode: de
    translations:
    - id: 0
      language: de
      text: Questgeber
    - id: 1
      language: de
      text: 'Hallo


'
    - id: 2
      language: de
      text: Gib mir eine Aufgabe
    - id: 3
      language: de
      text: Verlassen
    - id: 4
      language: de
      text: (@questStory)
    - id: 5
      language: de
      text: "Ja\t"
    - id: 6
      language: de
      text: Was brauchst du?
    - id: 7
      language: de
      text: Danke!
    - id: 8
      language: de
      text: "\xDCber die Aufgabe sprechen"
    - id: 9
      language: de
      text: Du hast die Aufgabe noch nicht abgeschlossen. Bleib dran und komm wieder,
        wenn du fertig bist.
    - id: 10
      language: de
      text: Questgeber
    - id: 11
      language: de
      text: Danke, dass du die Aufgabe erledigt hast. Hier ist deine Belohnung.
    - id: 12
      language: de
      text: (@giverName)
    - id: 13
      language: de
      text: (@questTurnInDialogue)
    - id: 14
      language: de
      text: (@turninDialogue)
    - id: 15
      language: de
      text: Hallo, Held!
    - id: 16
      language: de
      text: Brauchst du etwas?
    - id: 17
      language: de
      text: "Erz\xE4hl mir von deiner Aufgabe."
    - id: 18
      language: de
      text: Ja
    - id: 19
      language: de
      text: (@turnInDialogue)
    - id: 20
      language: de
      text: Guten Morgen, mein Freund!
    - id: 21
      language: de
      text: "Ach, du bist es wieder! Was kann ich f\xFCr dich tun?"
    - id: 22
      language: de
      text: "Sch\xF6n, dich zu sehen! Wie kann ich dir helfen?"
    - id: 23
      language: de
      text: "Willkommen! Was f\xFChrt dich her?"
    - id: 24
      language: de
      text: "Ich hoffe, die letzte Nacht war nicht allzu hart f\xFCr dich."
    - id: 25
      language: de
      text: Hast du noch etwas auf dem Herzen?
    - id: 26
      language: de
      text: "Was m\xF6chtest du sonst noch wissen?"
    - id: 27
      language: de
      text: "M\xF6chtest du noch \xFCber etwas sprechen?"
  - counter: 28
    languageCode: ru
    translations:
    - id: 0
      language: ru
      text: "\u0414\u0430\u0432\u0430\u0442\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0439"
    - id: 1
      language: ru
      text: "\u041F\u0440\u0438\u0432\u0435\u0442\n\n"
    - id: 2
      language: ru
      text: "\u0414\u0430\u0439 \u043C\u043D\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435"
    - id: 3
      language: ru
      text: "\u0412\u044B\u0439\u0442\u0438"
    - id: 4
      language: ru
      text: (@questStory)
    - id: 5
      language: ru
      text: "\u0414\u0430\t"
    - id: 6
      language: ru
      text: "\u0427\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E?"
    - id: 7
      language: ru
      text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
    - id: 8
      language: ru
      text: "\u041E\u0431\u0441\u0443\u0434\u0438\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0435"
    - id: 9
      language: ru
      text: "\u0422\u044B \u0435\u0449\u0451 \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B
        \u0437\u0430\u0434\u0430\u043D\u0438\u0435. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
        \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
        \u043A\u043E\u0433\u0434\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C."
    - id: 10
      language: ru
      text: "\u0414\u0430\u0432\u0430\u0442\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0439"
    - id: 11
      language: ru
      text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B
        \u0437\u0430\u0434\u0430\u043D\u0438\u0435. \u0412\u043E\u0442 \u0442\u0432\u043E\u044F
        \u043D\u0430\u0433\u0440\u0430\u0434\u0430."
    - id: 12
      language: ru
      text: (@giverName)
    - id: 13
      language: ru
      text: (@questTurnInDialogue)
    - id: 14
      language: ru
      text: (@turninDialogue)
    - id: 15
      language: ru
      text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0433\u0435\u0440\u043E\u0439!"
    - id: 16
      language: ru
      text: "\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u043D\u0443\u0436\u043D\u043E?"
    - id: 17
      language: ru
      text: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435
        \u043E \u0441\u0432\u043E\u0451\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0438."
    - id: 18
      language: ru
      text: "\u0414\u0430"
    - id: 19
      language: ru
      text: (@turnInDialogue)
    - id: 20
      language: ru
      text: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u0434\u0440\u0443\u0433!"
    - id: 21
      language: ru
      text: "\u041E, \u0441\u043D\u043E\u0432\u0430 \u0442\u044B! \u0427\u0435\u043C
        \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C?"
    - id: 22
      language: ru
      text: "\u0420\u0430\u0434 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C!
        \u0427\u0435\u043C \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C?"
    - id: 23
      language: ru
      text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!
        \u0427\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u0442\u0435\u0431\u044F
        \u0441\u044E\u0434\u0430?"
    - id: 24
      language: ru
      text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043F\u0440\u043E\u0448\u043B\u0430\u044F
        \u043D\u043E\u0447\u044C \u043D\u0435 \u0431\u044B\u043B\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u0442\u044F\u0436\u0451\u043B\u043E\u0439."
    - id: 25
      language: ru
      text: "\u0422\u0435\u0431\u044F \u0435\u0449\u0451 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442?"
    - id: 26
      language: ru
      text: "\u0427\u0442\u043E \u0435\u0449\u0451 \u0442\u044B \u0445\u043E\u0442\u0435\u043B
        \u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C?"
    - id: 27
      language: ru
      text: "\u0425\u043E\u0447\u0435\u0448\u044C \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C
        \u0435\u0449\u0451 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C?"
